# ==========================================
# SafarSetu Production Environment Variables
# ==========================================

# Core Django Settings
DJANGO_SETTINGS_MODULE=safarsetu.settings.prod
DJANGO_DEBUG=False
DJANGO_SECRET_KEY=generate-a-strong-random-50-character-secret-key-here
DJANGO_ALLOWED_HOSTS=yourdomain.com,api.yourdomain.com,safarsetu.onrender.com,127.0.0.1
CSRF_TRUSTED_ORIGINS=https://yourdomain.com,https://api.yourdomain.com,https://safarsetu.onrender.com

# PostgreSQL Database (e.g. Supabase, Neon, RDS, Render Postgres, or Docker container)
DATABASE_URL=postgres://safarsetu_user:safarsetu_password@localhost:5432/safarsetu
POSTGRES_DB=safarsetu
POSTGRES_USER=safarsetu_user
POSTGRES_PASSWORD=strong_postgres_password_here
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Cache & Channels & Celery Broker
REDIS_URL=redis://localhost:6379/1
CELERY_BROKER_URL=redis://localhost:6379/1
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# Security & SSL Settings
DJANGO_SECURE_SSL_REDIRECT=True
DJANGO_SESSION_COOKIE_SECURE=True
DJANGO_CSRF_COOKIE_SECURE=True
DJANGO_SECURE_HSTS_SECONDS=31536000
DJANGO_SECURE_HSTS_INCLUDE_SUBDOMAINS=True
DJANGO_SECURE_HSTS_PRELOAD=True

# CORS Settings
CORS_ALLOW_ALL_ORIGINS=False
CORS_ALLOWED_ORIGINS=https://yourdomain.com,https://app.yourdomain.com

# Optional Email / External Services
# DJANGO_EMAIL_BACKEND=django.core.mail.backends.smtp.EmailBackend
# EMAIL_HOST=smtp.sendgrid.net
# EMAIL_PORT=587
# EMAIL_HOST_USER=apikey
# EMAIL_HOST_PASSWORD=your_sendgrid_api_key
# EMAIL_USE_TLS=True
# DEFAULT_FROM_EMAIL=no-reply@yourdomain.com

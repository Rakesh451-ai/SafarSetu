# ==============================================================================
# SafarSetu Environment Configuration Example
# Copy this file to .env and adjust values for your environment
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-key-safarsetu-2026
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=safarsetu.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# Database Configuration
# 1. Zero-Cost & Free-Tier SQLite (Default - Zero setup required):
DATABASE_URL=sqlite:///db.sqlite3
# 2. PostgreSQL / Supabase / Neon / Render Free DB:
# DATABASE_URL=postgres://user:password@hostname:5432/safarsetu

# Google OAuth2 Authentication (Optional for Google Sign-In)
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=

# Redis Cache & Message Broker (Optional, falls back in dev)
REDIS_URL=redis://localhost:6379/1

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

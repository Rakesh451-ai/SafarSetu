# ==============================================================================
# SafarSetu Environment Configuration Example
# Copy this file to .env and adjust values for your environment
# ==============================================================================

# Django Core Settings
DJANGO_SECRET_KEY=django-insecure-change-this-in-production-key-safarsetu-2026
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=safarsetu.settings.dev
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,web

# Database Configuration (PostgreSQL / PostGIS)
# For local / Docker setup:
DATABASE_URL=postgres://safarsetu_user:safarsetu_password@localhost:5432/safarsetu
# For PostGIS backend use:
# DATABASE_URL=postgis://safarsetu_user:safarsetu_password@localhost:5432/safarsetu

# Individual DB parameters (optional fallback)
POSTGRES_DB=safarsetu
POSTGRES_USER=safarsetu_user
POSTGRES_PASSWORD=safarsetu_password
POSTGRES_HOST=localhost
POSTGRES_PORT=5432

# Redis Cache & Message Broker
REDIS_URL=redis://localhost:6379/1

# CORS Configuration
CORS_ALLOW_ALL_ORIGINS=True
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://localhost:5173,http://127.0.0.1:3000,http://127.0.0.1:5173

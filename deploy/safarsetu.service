[Unit]
Description=SafarSetu Daphne ASGI Service
After=network.target

[Service]
User=rakesh
Group=rakesh
WorkingDirectory=/home/rakesh/SafarSetu
Environment="PATH=/home/rakesh/SafarSetu/.venv/bin"
Environment="DJANGO_SETTINGS_MODULE=safarsetu.settings.dev"
ExecStart=/home/rakesh/SafarSetu/.venv/bin/daphne -b 0.0.0.0 -p 8000 safarsetu.asgi:application
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
